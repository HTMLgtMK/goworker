llm:
    # LLM API 端点
    endpoint: http://localhost:8000/v1
    # 模型名称
    model: gpt-4o
    # API Key（留空表示不需要认证）
    api_key: ""

sandbox:
    # 沙箱模式：off | normal | strict | readonly
    mode: normal

    # 允许的工作目录（空 = 使用当前目录）
    allowed_work_dir: ""

    # 拒绝执行的命令模式（空 = 使用内置默认值）
    # denied_patterns:
    #   - "rm -rf /"
    #   - ":(){ :|:& };:"

    # 高风险命令模式（空 = 使用内置默认值）
    # 支持纯字符串或带 desc 的结构体两种格式
    # risky_patterns:
    #   - "rm\\s+"
    #   - pattern: ">\\s+\\S"
    #     desc: "输出重定向到文件"

    # 追加的只读安全命令：命中直接放行，不触发 HITL 确认。
    # 支持裸命令名或 "命令 子命令" 两种形式：
    #   - "kubectl get"   # 仅放行 kubectl 的 get 子命令；delete/apply 等仍要确认
    #   - "terraform"     # 放行整个命令族（不推荐，子命令粒度更安全）
    # 声明放行不会跳过写参数校验（如 curl -o 仍会被拦）。
    # （内置已放行 curl/wget 只读、ls/cat/grep/echo、git status 等只读命令）
    # safe_commands:
    #   - "kubectl get"
    #   - "terraform plan"

memory:
    # agent 记忆模块：MTM（跨会话任务档案）+ LTM（长期事实条目）
    # 生命周期：STM 管会话内，固化检查点（/compact、退出、/new、/task checkpoint）
    # 才把任务写入 MTM，新会话开场（/new 后首个 run）注入提醒。
    enabled: true
    # 存储目录（默认 ~/.config/goworker/memory，含 ltm/ 与 mtm/ 两个子目录）
    # dir: ""

    # 保留的任务档案数（0 = 不裁剪）
    # task_keep: 50

    # 会话边界时注入最近 N 个未完成任务
    # task_inject_n: 3

    # 会话边界时注入的相关长期事实条数
    # ltm_inject_top_k: 8

    # 检查点固化时是否用 LLM 抽取长期事实（每条打 add/update/delete 决策）
    # ltm_extract: true

    # 注入块占上下文窗口的比例上限（0-1），防止记忆把窗口撑爆
    # inject_budget_ratio: 0.15

mcp:
    # MCP 服务器连接（stdio 传输）
    # 每个 server 暴露的工具以 mcp_<server>_<tool> 注册给 agent
    # 注意：MCP 工具在外部进程运行，不受本地 sandbox 管控，只连接可信 server
    servers:
      # - name: filesystem
      #   command: npx
      #   args: ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
