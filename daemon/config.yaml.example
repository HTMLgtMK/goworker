llm:
    # LLM API 端点
    endpoint: http://localhost:8000/v1
    # 模型名称
    model: gpt-4o
    # API Key（留空表示不需要认证）
    api_key: ""

sandbox:
    # 沙箱模式：off | normal | strict | readonly
    mode: normal

    # 允许的工作目录（空 = 使用当前目录）
    allowed_work_dir: ""

    # 拒绝执行的命令模式（空 = 使用内置默认值）
    # denied_patterns:
    #   - "rm -rf /"
    #   - ":(){ :|:& };:"

    # 高风险命令模式（空 = 使用内置默认值）
    # 支持纯字符串或带 desc 的结构体两种格式
    # risky_patterns:
    #   - "rm\\s+"
    #   - pattern: ">\\s+\\S"
    #     desc: "输出重定向到文件"

mcp:
    # MCP 服务器连接（stdio 传输）
    # 每个 server 暴露的工具以 mcp_<server>_<tool> 注册给 agent
    # 注意：MCP 工具在外部进程运行，不受本地 sandbox 管控，只连接可信 server
    servers:
      # - name: filesystem
      #   command: npx
      #   args: ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
